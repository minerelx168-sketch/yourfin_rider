# ─────────────────────────────────────────────────────────────
# YourFin Rider backend — copy to `.env` and fill in real values
# ─────────────────────────────────────────────────────────────

# MySQL connection (matches docker-compose.yml defaults)
DATABASE_URL="mysql://yourfin:yourfin_pass@localhost:3306/yourfin_rider"

# HTTP server
PORT=4000
NODE_ENV=development

# Auth — generate a long random string for production!
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Google Maps Platform — Distance Matrix API key.
# If empty, the backend falls back to Haversine (straight-line) distance,
# so the system still works in dev without a key.
GOOGLE_MAPS_API_KEY=""

# CORS — comma separated list of allowed origins (dashboard / web).
# Use * only for local dev.
CORS_ORIGINS="*"

# Public base URL used to build absolute photo URLs returned to clients
PUBLIC_BASE_URL="http://localhost:4000"

# Average urban motorbike speed (km/h) used to estimate ride time
# when falling back to Haversine distance.
FALLBACK_AVG_SPEED_KMH=25
