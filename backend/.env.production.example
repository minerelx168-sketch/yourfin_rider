# ─────────────────────────────────────────────────────────────
# YourFin Rider API — PRODUCTION env (copy to .env on the server / set as
# platform secrets). NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# MySQL (managed DB or the mysql service in docker-compose.prod.yml)
DATABASE_URL="mysql://USER:PASSWORD@DB_HOST:3306/yourfin_rider"

PORT=4000
NODE_ENV=production

# Auth — MUST be a long random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# Google Maps Distance Matrix key (restrict by API + IP in GCP).
# Leave empty to fall back to Haversine.
GOOGLE_MAPS_API_KEY=""

# CORS — set to your dashboard origin(s), comma separated. Do NOT use * in prod.
# (Not needed if the dashboard is served same-origin via the nginx /api proxy.)
CORS_ORIGINS="https://dashboard.yourdomain.com"

# Public base URL used to build absolute photo/slip URLs.
# Set to the public origin that serves /uploads (your site URL).
PUBLIC_BASE_URL="https://dashboard.yourdomain.com"

FALLBACK_AVG_SPEED_KMH=25
